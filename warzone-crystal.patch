diff --git a/tibia-idle/tools/test_warzone_crystal_tokens.js b/tibia-idle/tools/test_warzone_crystal_tokens.js
new file mode 100644
index 0000000..c6cd3c8
--- /dev/null
+++ b/tibia-idle/tools/test_warzone_crystal_tokens.js
@@ -0,0 +1,248 @@
+/* Deathstrike, Gnomevil e The Abyssador: 3 major crystalline tokens
+ * para cada participante, sempre — vivo ou morto, não só o líder. */
+"use strict";
+const path = require("path");
+const root = path.join(__dirname, "..");
+const wb = require(path.join(root, "server", "world_boss.js"));
+const engine = require(path.join(root, "server", "authoritative_engine.js"));
+
+function must(ok, msg) {
+  if (!ok) throw new Error(msg);
+}
+
+function tokenCount(holder, bundleId) {
+  return wb.rewardBundleItemCount(holder, bundleId, wb.MAJOR_CRYSTAL_TOKEN);
+}
+
+function shell(id, accountId, extra) {
+  return {
+    id: String(id),
+    accountId: accountId,
+    p: Object.assign({
+      id: String(id), name: "P" + id, voc: "knight", level: 100,
+      hp: 1000, mp: 100, gold: 0, equip: {}, skills: {},
+      accountId: accountId,
+      rewardChest: { "major-crystalline-token": 9 },
+      rewardChestBundles: [{ id: "old", items: { "major-crystalline-token": 9 } }],
+    }, extra || {}),
+  };
+}
+
+function killBoss(bossId, slug, bundleId) {
+  const members = [shell(1, 11), shell(2, 22, { hp: 0 }), shell(3, 33)];
+  const desc = {
+    v: 1, kind: "boss", huntId: null, bossId: bossId, instanceMode: "boss", worldBoss: true,
+    activeCharacterId: "1",
+    members: members,
+    state: {
+      worldBoss: true, gridW: 40, gridH: 40, rewardBundleId: bundleId,
+      players: members.map((m, i) => Object.assign({ cx: 10 + i, cy: 28 }, m)),
+      mobs: [{
+        slug: slug, boss: true, worldBoss: true, id: "boss-wb",
+        hp: 1, maxHp: 1, cx: 20, cy: 16,
+      }],
+      arenaBossSpawn: { spawned: true },
+    },
+  };
+  const initialized = engine.initializeAuthority(desc, "b".repeat(64), Date.now());
+  const auth = initialized.authority;
+  must(auth.rewardBundleId === bundleId, bossId + " não preservou rewardBundleId");
+  for (const item of auth.players) {
+    must(!item.p.rewardChest || !Object.keys(item.p.rewardChest).length,
+      bossId + " entrou com reward chest espelhado (dobraria o token)");
+  }
+  const deadAtStart = auth.players.find((item) => String(item.id) === "2");
+  deadAtStart.p.hp = 0;
+  deadAtStart.downUntil = Date.now() + 60000;
+  const boss = (auth.mobs || []).find((m) => m && m.boss);
+  must(boss, bossId + " não spawnou o boss");
+  boss.hp = 0;
+  const stepped = engine.advanceAuthorityState(initialized, 200, Date.now());
+  must(stepped && stepped.terminalReason === "boss-defeated", bossId + " não encerrou em boss-defeated");
+  const after = typeof stepped.state === "string" ? JSON.parse(stepped.state) : stepped.state;
+  const players = after.authority.players;
+  must(players.length === 3, bossId + " perdeu participantes");
+  for (const item of players) {
+    const n = tokenCount(item.p, bundleId);
+    must(n === 3, bossId + " char " + item.id + " recebeu " + n + " tokens, esperado 3");
+    must((Number(item.p.rewardChest[wb.MAJOR_CRYSTAL_TOKEN]) || 0) === 3,
+      bossId + " chest total do char " + item.id + " não é 3");
+  }
+  const dead = players.find((item) => String(item.id) === "2");
+  must(dead && Number(dead.p.hp) <= 0, bossId + " o morto reviveu antes do drop");
+  const kill = (after.authority.events || []).find((e) => e && e.t === "kill" && e.boss);
+  // events are drained into descriptor.state.events by materialize
+  const events = (after.state && after.state.events) || [];
+  const killEv = events.find((e) => e && e.t === "kill" && e.boss) || kill;
+  must(killEv, bossId + " sem evento de kill");
+  const drop = (killEv.loot || []).find((l) => l && l.item === wb.MAJOR_CRYSTAL_TOKEN);
+  must(drop && drop.count === 3 && drop.eachParticipant, bossId + " log não marca 3x por participante");
+}
+
+function emptyShared() {
+  return { v: 1, seq: 0, bag: {}, lootPouch: {}, depot: [], itemInstances: [], rewardChest: {}, rewardChestBundles: [] };
+}
+
+async function controllerGrant() {
+  const accounts = new Map();
+  const chars = new Map();
+  const tokens = new Map();
+  function addAcc(id, token) {
+    const acc = { id: id, token: token, shared: emptyShared() };
+    accounts.set(id, acc);
+    tokens.set(token, acc);
+    return acc;
+  }
+  function addChar(id, accountId, name) {
+    const c = {
+      id: id, account_id: accountId, name: name, voc: "knight", level: 100,
+      data: { id: String(id), name: name, voc: "knight", level: 100, hp: 500, mp: 50 },
+    };
+    chars.set(id, c);
+    return c;
+  }
+  addAcc(1, "tok-1");
+  addAcc(2, "tok-2");
+  addChar(101, 1, "Leader");
+  addChar(202, 2, "DeadMate");
+  process.env.WB_COUNTDOWN_MS = "1";
+  process.env.WB_MIN_START = "1";
+  const published = [];
+  const db = {
+    async findAccountByToken(token) { return tokens.get(token) || null; },
+    async findCharacter(id) { return chars.get(Number(id)) || null; },
+    async accountSharedInventory(id) { return accounts.get(Number(id)).shared; },
+    async setAccountSharedInventory(id, shared) {
+      accounts.get(Number(id)).shared = shared;
+      return accounts.get(Number(id));
+    },
+    async updateCharacter(id, voc, level, data) {
+      const c = chars.get(Number(id));
+      c.voc = voc; c.level = level; c.data = data;
+      return c;
+    },
+  };
+  const ctrl = wb.createWorldBossController({
+    testServer: true,
+    getDb: () => db,
+    publishAll: () => {},
+    publishAccount: (accountId, type, data) => published.push({ accountId, type, data }),
+    createSharedInstance: async (event) => ({
+      ok: true, instanceId: "c".repeat(64), ownerAccountId: event.hostAccountId,
+    }),
+    endSharedInstance: async () => {},
+    syncSharedBoss: async () => {},
+  });
+  const opened = await ctrl.createLobby(db, { token: "tok-1", warzoneId: "wz1", characterIds: [101] });
+  must(opened.code === 200, "createLobby wz1 falhou: " + JSON.stringify(opened.body));
+  const j2 = await ctrl.join(db, { token: "tok-2", characterIds: [202] });
+  must(j2.code === 200, "join participante falhou: " + JSON.stringify(j2.body));
+  const started = await ctrl.startFight(db, { token: "tok-1" });
+  must(started.code === 200, "startFight falhou: " + JSON.stringify(started.body));
+  let st = null;
+  for (let i = 0; i < 25; i++) {
+    await ctrl.tick(db);
+    await new Promise((r) => setTimeout(r, 20));
+    st = await ctrl.stateFor(db, "tok-1");
+    if (st.body && st.body.event && st.body.event.phase === "combat" && ctrl.sharedForAccount(1)) break;
+  }
+  must(st && st.body && st.body.event && st.body.event.phase === "combat",
+    "não entrou em combat: " + JSON.stringify(st && st.body && st.body.event));
+  const eventId = st.body.event.id;
+  const bundleId = "world-boss-" + eventId;
+  await ctrl.reportCombat(db, { token: "tok-2", deadCharIds: [202], damageDealt: 10 });
+  await ctrl.onSharedEnded("boss-defeated");
+  for (const accId of [1, 2]) {
+    const n = tokenCount(accounts.get(accId).shared, bundleId);
+    must(n === 3, "conta " + accId + " shared tem " + n + " tokens, esperado 3");
+  }
+  must(tokenCount(chars.get(202).data, bundleId) === 3, "personagem morto não recebeu 3 tokens");
+  must(tokenCount(chars.get(101).data, bundleId) === 3, "líder não recebeu 3 tokens");
+  const deadReward = published.find((ev) => ev.type === "world-boss" && ev.data && ev.data.action === "reward" &&
+    String(ev.data.charId) === "202");
+  must(deadReward, "SSE de reward não foi para o participante morto");
+
+  // Segunda chamada não pode dobrar: o evento já encerrou, e um top-up
+  // direto no shared com o mesmo bundle permanece em 3.
+  wb.topUpRewardBundle(accounts.get(2).shared, bundleId, wb.MAJOR_CRYSTAL_TOKEN, 3, {
+    bundleId, bossId: "wz1", name: "The Deathstrike — World Boss", sprite: "deathstrike",
+  });
+  must(tokenCount(accounts.get(2).shared, bundleId) === 3, "top-up idempotente dobrou os tokens");
+  ctrl.stop();
+}
+
+async function noDoubleAfterEngineGrant() {
+  process.env.WB_COUNTDOWN_MS = "1";
+  const accounts = new Map();
+  const chars = new Map();
+  const tokens = new Map();
+  const acc = { id: 7, token: "tok-7", shared: emptyShared() };
+  accounts.set(7, acc);
+  tokens.set("tok-7", acc);
+  chars.set(701, {
+    id: 701, account_id: 7, name: "Solo", voc: "druid", level: 80,
+    data: { id: "701", name: "Solo", voc: "druid", level: 80 },
+  });
+  const db = {
+    async findAccountByToken(token) { return tokens.get(token) || null; },
+    async findCharacter(id) { return chars.get(Number(id)) || null; },
+    async accountSharedInventory(id) { return accounts.get(Number(id)).shared; },
+    async setAccountSharedInventory(id, shared) {
+      accounts.get(Number(id)).shared = shared;
+      return accounts.get(Number(id));
+    },
+    async updateCharacter(id, voc, level, data) {
+      const c = chars.get(Number(id));
+      c.data = data; c.voc = voc; c.level = level;
+      return c;
+    },
+  };
+  const ctrl = wb.createWorldBossController({
+    testServer: true,
+    publishAll: () => {},
+    publishAccount: () => {},
+    createSharedInstance: async (event) => ({
+      ok: true, instanceId: "d".repeat(64), ownerAccountId: event.hostAccountId,
+    }),
+    endSharedInstance: async () => {},
+  });
+  const opened = await ctrl.createLobby(db, { token: "tok-7", warzoneId: "wz3", characterIds: [701] });
+  must(opened.code === 200, "lobby wz3 falhou: " + JSON.stringify(opened.body));
+  await ctrl.startFight(db, { token: "tok-7" });
+  let eventId = null;
+  for (let i = 0; i < 25; i++) {
+    await ctrl.tick(db);
+    await new Promise((r) => setTimeout(r, 20));
+    const st = await ctrl.stateFor(db, "tok-7");
+    if (st.body && st.body.event && st.body.event.phase === "combat") {
+      eventId = st.body.event.id;
+      break;
+    }
+  }
+  must(eventId, "wz3 não entrou em combate");
+  const bundleId = "world-boss-" + eventId;
+  const source = { bundleId, bossId: "wz3", name: "The Abyssador — World Boss", sprite: "abyssador" };
+  wb.topUpRewardBundle(acc.shared, bundleId, wb.MAJOR_CRYSTAL_TOKEN, 3, source);
+  chars.get(701).data.rewardChest = { "major-crystalline-token": 3 };
+  chars.get(701).data.rewardChestBundles = [{ id: bundleId, items: { "major-crystalline-token": 3 } }];
+  await ctrl.onSharedEnded("boss-defeated");
+  must(tokenCount(acc.shared, bundleId) === 3, "grantSuccessRewards dobrou o token já persistido pelo motor");
+  must(tokenCount(chars.get(701).data, bundleId) === 3, "personagem ficou com mais de 3 tokens");
+  ctrl.stop();
+}
+
+async function main() {
+  must(!JSON.stringify(wb.FIXED_WORLD_BOSS_LOOT).includes(wb.MAJOR_CRYSTAL_TOKEN),
+    "FIXED_WORLD_BOSS_LOOT ainda inclui o token (dobraria com o grant por participante)");
+  killBoss("world-boss-wz1", "deathstrike", "world-boss-evt-wz1");
+  killBoss("world-boss-wz2", "gnomevil", "world-boss-evt-wz2");
+  killBoss("world-boss-wz3", "abyssador", "world-boss-evt-wz3");
+  await controllerGrant();
+  await noDoubleAfterEngineGrant();
+  console.log("ok: 3 major crystalline tokens por participante");
+}
+
+main().catch((e) => {
+  console.error(e && e.stack || e);
+  process.exit(1);
+});

# Configuração da API de contas do Global-Idle
# Copie para .env e ajuste conforme o ambiente.
# Nunca commite .env com segredos reais.

# ---- HTTP ----
# Em SaveInCloud/Jelastic a plataforma injeta PORT; não fixe 3333 em produção.
PORT=3333
HOST=0.0.0.0

# ---- Manutenção / deploy (countdown 30s nos clientes) ----
# Token para POST /api/maintenance/schedule (header X-Maintenance-Token).
# Em TEST_SERVER=1, se vazio, o endpoint aceita sem token (alpha).
# MAINTENANCE_TOKEN=troque-este-segredo

# Lease exclusivo de simulação por conta (2 minutos)
LEASE_TTL_MS=120000
SESSION_TTL_MS=86400000

# CORS: same-origin (jogo + API na mesma URL) é sempre aceito.
# Use ALLOWED_ORIGINS só se o frontend estiver em outro host.
# ALLOWED_ORIGINS=https://jogo.exemplo.com
# Com Shared Load Balancer (SLB) ligado, ative TRUST_PROXY:
# TRUST_PROXY=1
# RATE_LIMIT_DISABLED=0

# Worker de relógio idle (claim transacional sem browser)
INSTANCE_WORKER_INTERVAL_MS=1000
INSTANCE_WORKER_MAX_STEP_MS=3600000
# INSTANCE_WORKER_STARTUP_GRACE_MS=5000

# Estáticos do jogo (padrão: ../game relativo a server.js)
# STATIC_DIR=../game
# STATIC_IMAGES_DIR=../imagens  # Servida pela URL /imagens/...

# Persistência JSON (quando MYSQL_HOST está vazio).
# Em PaaS, aponte para um volume montado para sobreviver a redeploys:
# GLOBAL_IDLE_DATA_DIR=/data/global-idle

# ---- MySQL (opcional) ----
# Deixe MYSQL_HOST VAZIO para usar storage JSON local (recomendado no alpha trial).
# Local (Windows/XAMPP): suba o MySQL, crie o DB `global_idle`, preencha abaixo.
# O schema é criado automaticamente em ensureSchema() no boot.
# Para importar JSON antigo: node ../tools/migrate_json_to_mysql.js
# Voltar ao JSON: esvazie MYSQL_HOST (ou remova a linha) e reinicie.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=global_idle

# Exemplo local com XAMPP (root senha = admin neste PC):
# PORT=8001
# TEST_SERVER=1
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=admin
# MYSQL_DB=global_idle
# World Boss (TEST_SERVER default WB_MIN_START=2; prod=20):
# Rotação default = 3h mesmo com TEST_SERVER. Para testes rápidos: WB_ROTATION_MS=180000
# WB_ROTATION_MS=10800000
# WB_MIN_START=2
# WB_LOBBY_MS=75000
# WB_MAX_CHARS=30

# ---- Mercado Pago (STORE / Tibia Coins) ----
# Access Token de PRODUÇÃO (ou TEST-... para sandbox). Sem isso o checkout
# recusa pagamento real; no TEST_SERVER o admin ainda pode simular.
# MP_ACCESS_TOKEN=
# Public Key (opcional, Brick/cartão no cliente):
# MP_PUBLIC_KEY=
# URL pública HTTPS do jogo (webhook + retorno do checkout):
# PUBLIC_BASE_URL=https://global-idle.com

# ---- Exemplo SaveInCloud alpha (variáveis no painel, não em arquivo) ----
# PORT=<injetado pela plataforma>
# HOST=0.0.0.0
# TEST_SERVER=1
# NODE_ENV=production
# TRUST_PROXY=1
# MYSQL_HOST=
# GLOBAL_IDLE_DATA_DIR=/data/global-idle
# UPDATE_PACKAGES_ON_RESTART=true
# APP_FILE=server/server.js
# PACKAGE_MANAGER=npm

# ---- E-mail transacional (SMTP) ----
# Cloudflare Email SMTP (recomendado — já temos DKIM/SPF/DMARC no domínio):
#   SMTP_HOST=smtp.mx.cloudflare.net
#   SMTP_PORT=465
#   SMTP_SECURE=1
#   SMTP_USER=api_token
#   SMTP_PASS=   <-- API Token da Cloudflare com escopo "Email Sending"
#   SMTP_FROM=suporte@global-idle.com
# Outros provedores: ajuste HOST/PORT/SECURE (0=STARTTLS 587, 1=SSL 465).
# Sem SMTP_* em produção o envio de código falha com "smtp-unconfigured".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@global-idle.com

# ---- Turnstile (anti-bot na criacao de conta) ----
# Cloudflare dashboard -> Turnstile -> Add site. Sem as chaves a verificacao
# fica desabilitada (dev/local nao trava).
#   TURNSTILE_SITEKEY=   <-- chave publica do site
#   TURNSTILE_SECRET=    <-- chave secreta

# ---- Login social (OAuth) ----
# Google: OAuth client "Web" no Google Cloud Console.
# Twitch: mesmo app do gate de voucher — registre OAUTH_REDIRECT_URI nele.
# Discord: app em discord.com/developers/applications — registre a
#   OAUTH_REDIRECT_URI (+ a de producao https://global-idle.com/api/oauth/callback)
#   em OAuth2 > Redirects. Sem as chaves, o botao Discord nao aparece.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://global-idle.com/api/oauth/callback

# ---- RMT / KYC 18+ (verificacao para vender TC) ----
# Gate exigido para criar solicitacoes de venda de TC via PIX:
#   CPF valido + data de nascimento 18+ + consentimento LGPD +
#   chave PIX obrigatoriamente do tipo CPF igual ao documento.
# RMT_KYC_REQUIRED=0 desliga o gate (so legado/dev — nao usar em producao).
#   RMT_KYC_REQUIRED=1
# Unicidade 1 CPF = 1 conta via HMAC (chave dedicada; cai pro RMT_ENC_KEY).
#   KYC_HMAC_KEY=
# Provedor de consulta CPF (nome+nascimento batem numa base real):
#   "none" (default) -> perfil fica 'pending' e o admin aprova/reprova manual
#     no painel RMT (mesmo modelo do pagamento PIX manual).
#   "mock" -> auto-aprova; so funciona em TEST_SERVER (dev local).
# Adapters reais (idwall/CAF/BigDataCorp/DataValid) plugam em server/kyc.js.
#   KYC_PROVIDER=

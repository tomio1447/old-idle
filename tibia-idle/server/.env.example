# Configuração da API de contas do Global-Idle
# Copie para .env e ajuste conforme sua máquina.

# Porta/Host da API HTTP (login/register/save)
PORT=3333
HOST=0.0.0.0

# ---- MySQL ----
# Deixe MYSQL_HOST VAZIO para usar o storage JSON local (desenvolvimento)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=sua_senha
MYSQL_DB=global_idle

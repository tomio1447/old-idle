# Configuração da API de contas do Global-Idle
# Copie para .env e ajuste conforme sua máquina.

# Porta/Host da API HTTP (login/register/save)
PORT=3333
HOST=0.0.0.0

# Test server: injeta modo online, cria 1/1 e 2/2 e libera Admin
TEST_SERVER=0
# Lease exclusivo de simulação por conta (2 minutos)
LEASE_TTL_MS=120000
SESSION_TTL_MS=86400000
# CORS explícito para origens adicionais (same-origin é sempre aceito)
# ALLOWED_ORIGINS=https://jogo.exemplo.com
# TRUST_PROXY=1
# RATE_LIMIT_DISABLED=0
# Worker de relógio idle (claim transacional sem browser)
INSTANCE_WORKER_INTERVAL_MS=1000
INSTANCE_WORKER_MAX_STEP_MS=3600000
# STATIC_DIR=../game
# GLOBAL_IDLE_DATA_DIR=./data

# ---- MySQL ----
# Deixe MYSQL_HOST VAZIO para usar o storage JSON local (desenvolvimento)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=sua_senha
MYSQL_DB=global_idle

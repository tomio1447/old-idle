# Configuração da API de contas do Global-Idle
# Copie para .env e ajuste conforme o ambiente.
# Nunca commite .env com segredos reais.

# ---- HTTP ----
# Em SaveInCloud/Jelastic a plataforma injeta PORT; não fixe 3333 em produção.
PORT=3333
HOST=0.0.0.0

# ---- Manutenção / deploy (countdown 30s nos clientes) ----
# Token para POST /api/maintenance/schedule (header X-Maintenance-Token).
# Em TEST_SERVER=1, se vazio, o endpoint aceita sem token (alpha).
# MAINTENANCE_TOKEN=troque-este-segredo

# Lease exclusivo de simulação por conta (2 minutos)
LEASE_TTL_MS=120000
SESSION_TTL_MS=86400000

# CORS: same-origin (jogo + API na mesma URL) é sempre aceito.
# Use ALLOWED_ORIGINS só se o frontend estiver em outro host.
# ALLOWED_ORIGINS=https://jogo.exemplo.com
# Com Shared Load Balancer (SLB) ligado, ative TRUST_PROXY:
# TRUST_PROXY=1
# RATE_LIMIT_DISABLED=0

# Worker de relógio idle (claim transacional sem browser)
INSTANCE_WORKER_INTERVAL_MS=1000
INSTANCE_WORKER_MAX_STEP_MS=3600000
# INSTANCE_WORKER_STARTUP_GRACE_MS=5000

# Estáticos do jogo (padrão: ../game relativo a server.js)
# STATIC_DIR=../game

# Persistência JSON (quando MYSQL_HOST está vazio).
# Em PaaS, aponte para um volume montado para sobreviver a redeploys:
# GLOBAL_IDLE_DATA_DIR=/data/global-idle

# ---- MySQL (opcional) ----
# Deixe MYSQL_HOST VAZIO para usar storage JSON local (recomendado no alpha trial).
# Local (Windows/XAMPP): suba o MySQL, crie o DB `global_idle`, preencha abaixo.
# O schema é criado automaticamente em ensureSchema() no boot.
# Para importar JSON antigo: node ../tools/migrate_json_to_mysql.js
# Voltar ao JSON: esvazie MYSQL_HOST (ou remova a linha) e reinicie.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=global_idle

# Exemplo local com XAMPP (root senha = admin neste PC):
# PORT=8001
# TEST_SERVER=1
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=admin
# MYSQL_DB=global_idle

# ---- Exemplo SaveInCloud alpha (variáveis no painel, não em arquivo) ----
# PORT=<injetado pela plataforma>
# HOST=0.0.0.0
# TEST_SERVER=1
# NODE_ENV=production
# TRUST_PROXY=1
# MYSQL_HOST=
# GLOBAL_IDLE_DATA_DIR=/data/global-idle
# UPDATE_PACKAGES_ON_RESTART=true
# APP_FILE=server/server.js
# PACKAGE_MANAGER=npm
